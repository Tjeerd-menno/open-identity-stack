<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Tjeerd-menno/open-identity-stack</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <!-- string.Equals and string.Contains without StringComparison fail the build.
       Infrastructure search Contains is an EF translation, so the analyzer stays on
       Domain, Application, and Api. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'OpenIdentityStack.Domain' OR '$(MSBuildProjectName)' == 'OpenIdentityStack.Application' OR '$(MSBuildProjectName)' == 'OpenIdentityStack.Api'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/OpenIdentityStack.Analyzers/OpenIdentityStack.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
