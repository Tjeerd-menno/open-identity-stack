@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8" /><title>Confirm sign out</title></head>
<body>
    <main>
        <h1>Sign out?</h1>
        <form method="post" action="/connect/logout">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id_token_hint" value="@ViewData["IdTokenHint"]" />
            <input type="hidden" name="post_logout_redirect_uri" value="@ViewData["PostLogoutRedirectUri"]" />
            <input type="hidden" name="state" value="@ViewData["State"]" />
            <input type="hidden" name="client_id" value="@ViewData["ClientId"]" />
            <input type="hidden" name="confirm_logout" value="true" />
            <button type="submit">Sign out</button>
        </form>
    </main>
</body>
</html>
