@using OpenIdentityStack.Api.Authentication
@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var isLocalDefault = (bool)(ViewData["IsLocalDefault"] ?? true);
    var localFallbackEnabled = (bool)(ViewData["LocalFallbackEnabled"] ?? true);
    var defaultProviderName = ViewData["DefaultProviderName"]?.ToString();
    var defaultProviderDisplayName = ViewData["DefaultProviderDisplayName"]?.ToString() ?? "External Provider";
    var fresh = (bool)(ViewData["Fresh"] ?? false);

    // Show external provider button if external is default and provider is configured
    var showExternalProvider = !isLocalDefault && !string.IsNullOrEmpty(defaultProviderName);
    var showLocalForm = isLocalDefault || localFallbackEnabled;
}

<div class="auth-shell">
    <div class="brand-lockup">
        <span class="brand-mark">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1Z" />
                <path d="m9 12 2 2 4-4" />
            </svg>
        </span>
        <span class="brand-name">OpenIdentity<span class="accent">Stack</span></span>
    </div>

    <div class="container">
        <h1 class="auth-title">Sign in</h1>
        <p class="auth-subtitle">Sign in to your account</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary">
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        @if (showExternalProvider)
        {
            <a href="@Url.Action("ExternalLogin", "Account", new { provider = defaultProviderName, returnUrl = ViewData["ReturnUrl"], fresh = fresh })"
               class="btn btn-default">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                    <polyline points="10 17 15 12 10 7" />
                    <line x1="15" x2="3" y1="12" y2="12" />
                </svg>
                Continue with @defaultProviderDisplayName
            </a>

            @if (showLocalForm)
            {
                <div class="divider"><span>or sign in with email</span></div>
            }
        }

        @if (showLocalForm)
        {
            <form method="post" asp-action="Login" asp-controller="Account">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                @Html.AntiForgeryToken()

                <div class="field">
                    <label for="Email">Email</label>
                    <div class="input-wrap has-left">
                        <span class="icon-left">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect width="20" height="16" x="2" y="4" rx="2" />
                                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                            </svg>
                        </span>
                        <input type="email"
                               id="Email"
                               name="Email"
                               value="@Model?.Email"
                               placeholder="you@example.com"
                               autocomplete="email"
                               required />
                    </div>
                    @if (ViewData.ModelState["Email"]?.Errors.Count > 0)
                    {
                        <div class="validation-error">@ViewData.ModelState["Email"]?.Errors[0].ErrorMessage</div>
                    }
                </div>

                <div class="field">
                    <label for="Password">Password</label>
                    <div class="input-wrap has-right">
                        <input type="password"
                               id="Password"
                               name="Password"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />
                        <button type="button" class="pw-toggle" aria-label="Toggle password visibility">
                            <span class="icon-eye">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </span>
                            <span class="icon-eye-off">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24" />
                                    <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68" />
                                    <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61" />
                                    <line x1="2" x2="22" y1="2" y2="22" />
                                </svg>
                            </span>
                        </button>
                    </div>
                    @if (ViewData.ModelState["Password"]?.Errors.Count > 0)
                    {
                        <div class="validation-error">@ViewData.ModelState["Password"]?.Errors[0].ErrorMessage</div>
                    }
                </div>

                <div class="field-check">
                    <input type="checkbox" id="RememberMe" name="RememberMe" value="true" />
                    <label for="RememberMe">Remember me</label>
                </div>

                <button type="submit" class="btn btn-primary">
                    @(showExternalProvider ? "Sign in with local account" : "Sign in")
                </button>
            </form>
        }
    </div>

    <p class="auth-footer">Protected by OpenIdentityStack · OpenID Connect</p>
</div>

<script>
    (function () {
        var toggle = document.querySelector('.pw-toggle');
        if (!toggle) { return; }
        var input = document.getElementById('Password');
        toggle.addEventListener('click', function () {
            var reveal = input.type === 'password';
            input.type = reveal ? 'text' : 'password';
            toggle.classList.toggle('showing', reveal);
        });
    })();
</script>
