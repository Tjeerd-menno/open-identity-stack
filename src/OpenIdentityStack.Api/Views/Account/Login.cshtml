@using OpenIdentityStack.Api.Authentication
@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var isLocalDefault = (bool)(ViewData["IsLocalDefault"] ?? true);
    var localFallbackEnabled = (bool)(ViewData["LocalFallbackEnabled"] ?? true);
    var defaultProviderName = ViewData["DefaultProviderName"]?.ToString();
    var defaultProviderDisplayName = ViewData["DefaultProviderDisplayName"]?.ToString() ?? "External Provider";
    var fresh = (bool)(ViewData["Fresh"] ?? false);
    
    // Show external provider button if external is default and provider is configured
    var showExternalProvider = !isLocalDefault && !string.IsNullOrEmpty(defaultProviderName);
}

<div class="container">
    <div class="logo">
        <h1>OpenIdentityStack</h1>
        <p>Sign in to your account</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="validation-summary">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    @if (showExternalProvider)
    {
        <!-- External provider login button (primary option when external is default) -->
        <div class="external-provider-section">
            <a href="@Url.Action("ExternalLogin", "Account", new { provider = defaultProviderName, returnUrl = ViewData["ReturnUrl"], fresh = fresh })" 
               class="btn-primary btn-external">
                Login with @defaultProviderDisplayName
            </a>
        </div>
        
        @if (localFallbackEnabled)
        {
            <div class="divider">
                <span>or</span>
            </div>
        }
    }

    @if (isLocalDefault || localFallbackEnabled)
    {
        <!-- Local login form -->
        <form method="post" asp-action="Login" asp-controller="Account">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="Email">Email</label>
                <input type="email" 
                       id="Email" 
                       name="Email" 
                       value="@Model?.Email" 
                       placeholder="Enter your email"
                       autocomplete="email"
                       required />
                @if (ViewData.ModelState["Email"]?.Errors.Count > 0)
                {
                    <div class="validation-error">@ViewData.ModelState["Email"]?.Errors[0].ErrorMessage</div>
                }
            </div>

            <div class="form-group">
                <label for="Password">Password</label>
                <input type="password" 
                       id="Password" 
                       name="Password" 
                       placeholder="Enter your password"
                       autocomplete="current-password"
                       required />
                @if (ViewData.ModelState["Password"]?.Errors.Count > 0)
                {
                    <div class="validation-error">@ViewData.ModelState["Password"]?.Errors[0].ErrorMessage</div>
                }
            </div>

            <div class="form-check">
                <input type="checkbox" id="RememberMe" name="RememberMe" value="true" />
                <label for="RememberMe">Remember me</label>
            </div>

            <button type="submit" class="btn-primary @(showExternalProvider ? "btn-secondary-style" : "")">
                @(showExternalProvider ? "Sign in with local account" : "Sign In")
            </button>
        </form>
    }
</div>
