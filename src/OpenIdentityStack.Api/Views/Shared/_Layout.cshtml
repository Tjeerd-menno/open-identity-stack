@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OpenIdentityStack</title>
    <style>
        /* ===========================================================
           OpenIdentityStack Design System tokens (Mantine-based).
           Light is the default; dark follows the OS preference.
           =========================================================== */
        :root {
            --surface-sunken: #f8f9fa;
            --surface-card: #ffffff;
            --surface-hover: #f8f9fa;
            --ois-primary: #228be6;
            --ois-primary-hover: #1c7ed6;
            --text-strong: #000000;
            --text-body: #212529;
            --text-muted: #868e96;
            --text-link: #228be6;
            --border-default: #dee2e6;
            --border-strong: #ced4da;
            --border-input: #ced4da;
            --color-danger: #e03131;
            --color-danger-light: #fff5f5;
            --color-danger-border: #ffc9c9;
            --radius-sm: 4px;
            --radius-md: 8px;
            --radius-brand: 9px;
            --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.05) 0 10px 15px -5px, rgba(0, 0, 0, 0.04) 0 7px 7px -5px;
            --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji";
            color-scheme: light;
        }

        @@media (prefers-color-scheme: dark) {
            :root {
                --surface-sunken: #1f1f1f;
                --surface-card: #242424;
                --surface-hover: #2e2e2e;
                --ois-primary: #1971c2;
                --ois-primary-hover: #1c7ed6;
                --text-strong: #ffffff;
                --text-body: #c9c9c9;
                --text-muted: #828282;
                --text-link: #4dabf7;
                --border-default: #424242;
                --border-strong: #696969;
                --border-input: #424242;
                --color-danger: #ff8787;
                --color-danger-light: rgba(250, 82, 82, 0.15);
                --color-danger-border: rgba(250, 82, 82, 0.30);
                color-scheme: dark;
            }
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-sans);
            background-color: var(--surface-sunken);
            color: var(--text-body);
            margin: 0;
            padding: 24px;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .auth-shell {
            width: 400px;
            max-width: 100%;
        }

        /* Brand lockup above the card */
        .brand-lockup {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 11px;
            margin-bottom: 22px;
        }

        .brand-mark {
            width: 36px;
            height: 36px;
            flex-shrink: 0;
            border-radius: var(--radius-brand);
            background: var(--ois-primary);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .brand-name {
            font-size: 19px;
            font-weight: 700;
            letter-spacing: -0.3px;
            color: var(--text-strong);
        }

        .brand-name .accent {
            color: var(--text-link);
        }

        /* Card surface (also used by AccessDenied) */
        .container {
            background: var(--surface-card);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            padding: 32px;
            width: 100%;
            max-width: 400px;
            margin: 0 auto;
        }

        .auth-title {
            font-size: 22px;
            font-weight: 700;
            color: var(--text-strong);
            margin: 0 0 4px;
        }

        .auth-subtitle {
            font-size: 14px;
            color: var(--text-muted);
            margin: 0 0 22px;
        }

        /* Generic logo block (AccessDenied) */
        .logo {
            text-align: center;
            margin-bottom: 24px;
        }

        .logo h1 {
            color: var(--text-strong);
            font-size: 22px;
            font-weight: 700;
            margin: 0;
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .field > label {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-body);
        }

        .input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-wrap .icon-left {
            position: absolute;
            left: 12px;
            display: flex;
            color: var(--text-muted);
            pointer-events: none;
        }

        .field input[type="email"],
        .field input[type="password"],
        .field input[type="text"] {
            width: 100%;
            height: 36px;
            font-size: 14px;
            font-family: var(--font-sans);
            color: var(--text-body);
            background: var(--surface-card);
            border: 1px solid var(--border-input);
            border-radius: var(--radius-md);
            padding: 0 12px;
            outline: none;
            transition: border-color 150ms;
        }

        .input-wrap.has-left input {
            padding-left: 38px;
        }

        .input-wrap.has-right input {
            padding-right: 38px;
        }

        .field input::placeholder {
            color: var(--text-muted);
        }

        .field input:focus {
            border-color: var(--ois-primary);
        }

        .pw-toggle {
            position: absolute;
            right: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: none;
            border: none;
            padding: 2px;
            cursor: pointer;
            color: var(--text-muted);
        }

        .pw-toggle .icon-eye-off { display: none; }
        .pw-toggle.showing .icon-eye { display: none; }
        .pw-toggle.showing .icon-eye-off { display: inline-flex; }

        .field-check {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .field-check input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: var(--ois-primary);
            margin: 0;
        }

        .field-check label {
            font-size: 14px;
            font-weight: 400;
            color: var(--text-body);
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            height: 42px;
            padding: 0 22px;
            font-size: 16px;
            font-weight: 600;
            font-family: var(--font-sans);
            line-height: 1;
            border: 1px solid transparent;
            border-radius: var(--radius-md);
            cursor: pointer;
            white-space: nowrap;
            text-decoration: none;
            transition: background-color 150ms, border-color 150ms;
        }

        .btn-primary {
            background: var(--ois-primary);
            color: #fff;
        }

        .btn-primary:hover {
            background: var(--ois-primary-hover);
        }

        .btn-default {
            background: var(--surface-card);
            color: var(--text-body);
            border-color: var(--border-strong);
        }

        .btn-default:hover {
            background: var(--surface-hover);
        }

        /* Divider with centered label */
        .divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 20px 0;
        }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border-default);
        }

        .divider span {
            font-size: 12px;
            color: var(--text-muted);
            white-space: nowrap;
        }

        /* Validation */
        .validation-summary {
            background: var(--color-danger-light);
            border: 1px solid var(--color-danger-border);
            color: var(--color-danger);
            padding: 12px;
            border-radius: var(--radius-md);
            margin-bottom: 16px;
            font-size: 14px;
        }

        .validation-summary ul {
            margin: 0;
            padding-left: 20px;
        }

        .validation-error {
            color: var(--color-danger);
            font-size: 12px;
        }

        .auth-footer {
            text-align: center;
            font-size: 12.5px;
            color: var(--text-muted);
            margin-top: 18px;
        }

        .auth-link {
            color: var(--text-link);
            text-decoration: none;
        }

        .auth-link:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    @RenderBody()
</body>
</html>
